# Кэши Python и тестов (runtime появится на последующих этапах)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Локальная конфигурация и секреты
.env
.env.*
!.env.example

# Сгенерированные данные распознавания, модели, benchmarks и приватные fixtures
/data/
/models/
/artifacts/
/benchmark-results/
/tests/fixtures/private/

# Редакторы и операционные системы
.idea/
.vscode/
.DS_Store
Thumbs.db
